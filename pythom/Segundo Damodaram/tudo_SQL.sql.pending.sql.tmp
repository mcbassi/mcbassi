-- Copiando estrutura para tabela statistics.etl_import_issue
DROP TABLE IF EXISTS `etl_import_issue`;
CREATE TABLE IF NOT EXISTS `etl_import_issue` (
  `id` bigint(20) unsigned NOT NULL AUTO_INCREMENT,
  `import_batch_id` bigint(20) unsigned NOT NULL,
  `severity` varchar(20) NOT NULL DEFAULT 'warning',
  `issue_type` varchar(50) NOT NULL COMMENT 'parse_error, duplicate_sheet, text_number, formula_error, unmapped_sector, etc.',
  `sheet_name` varchar(150) DEFAULT NULL,
  `row_num` int(11) DEFAULT NULL,
  `col_num` int(11) DEFAULT NULL,
  `issue_message` text NOT NULL,
  `raw_value_text` text DEFAULT NULL,
  `created_at` timestamp NOT NULL DEFAULT current_timestamp(),
  PRIMARY KEY (`id`),
  KEY `idx_import_issue_batch` (`import_batch_id`,`severity`),
  CONSTRAINT `fk_import_issue_batch` FOREIGN KEY (`import_batch_id`) REFERENCES `etl_import_batch` (`id`)
) ENGINE=InnoDB AUTO_INCREMENT=1408 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_general_ci;
-- Copiando dados para a tabela statistics.etl_import_issue: ~951 rows (aproximadamente)
DELETE FROM `etl_import_issue`;
